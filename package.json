{
  "name": "guanggu-forum-app",
  "version": "1.0.0",
  "packageManager": "yarn@3.2.2",
  "private": true,
  "description": "光谷过早客论坛 app",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ packages/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ packages/ --ext .ts,.tsx --fix"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.7.7",
    "@tarojs/components": "4.1.10",
    "@tarojs/helper": "4.1.10",
    "@tarojs/plugin-framework-react": "4.1.10",
    "@tarojs/plugin-platform-weapp": "4.1.10",
    "@tarojs/react": "4.1.10",
    "@tarojs/router": "4.1.10",
    "@tarojs/runtime": "4.1.10",
    "@tarojs/shared": "4.1.10",
    "@tarojs/taro": "4.1.10",
    "guanggu-forum-api": "workspace:^",
    "path-to-regexp": "^6.2.1",
    "query-string": "^7.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "url": "^0.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/preset-react": "^7.28.5",
    "@tarojs/cli": "4.1.10",
    "@tarojs/vite-runner": "4.1.10",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-preset-taro": "4.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^8.12.0",
    "eslint-config-taro": "4.1.10",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "prettier": "3.3.2",
    "react-refresh": "0.11.0",
    "stylelint": "^14.4.0",
    "typescript": "^5.1.0",
    "vite": "^4",
    "vitest": "^4.1.5"
  }
}
